# Application Environment (development | production)
APP_ENV="development"

# PostgreSQL connection string
# Local Docker Postgres: postgresql://zenivixon:changeme@localhost:5432/zenivixon_db
# Cloud (e.g. Neon): postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://zenivixon:changeme@localhost:5432/zenivixon_db"

# Qdrant Vector Database
# Local: http://localhost:6333
# Cloud: https://<your-cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# Google Gemini API
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Security & Operations Console Authentication (REQUIRED in production)
ADMIN_PASSCODES="zenivixon-admin-2026"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"
RATE_LIMIT_PER_MINUTE="30"

# Zendesk Escalation Integration (Optional - falls back to mock if unset)
ZENDESK_SUBDOMAIN=""
ZENDESK_EMAIL=""
ZENDESK_API_TOKEN=""
